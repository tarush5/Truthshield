# ═══════════════════════════════════════════════════════════════
# TruthShield configuration
#
# Copy to .env and edit. Anything security-relevant defaults to the
# strict value, so a setting you forget fails closed rather than open.
# ═══════════════════════════════════════════════════════════════

# ── Environment ────────────────────────────────────────────────
# production | development | test
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# ── Security (required) ────────────────────────────────────────
# Signs every session token. Startup FAILS in production without a real
# value — a shipped default is a published signing key.
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_EXPIRATION_MINUTES=60

# Exact frontend origins, comma separated. "*" is rejected: the API is
# called with credentials, which browsers refuse to pair with a wildcard.
CORS_ORIGINS=http://localhost:5173

RATE_LIMIT=60/minute
MAX_UPLOAD_SIZE_MB=25
MAX_TEXT_LENGTH=20000

# ── Database ───────────────────────────────────────────────────
# SQLite by default so a fresh checkout runs with nothing else installed.
# It is refused when APP_ENV=production — switch to the Postgres line below
# before deploying. docker compose sets the Postgres URL for you.
DATABASE_URL=sqlite:///./truthshield.db
# DATABASE_URL=postgresql+psycopg2://truthshield:truthshield@localhost:5432/truthshield

# ── Cache and queue ────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=900
# Runs Celery tasks inline instead of dispatching them; used by tests.
CELERY_TASK_ALWAYS_EAGER=false

# ── Analysis ───────────────────────────────────────────────────
EVIDENCE_TIMEOUT_SECONDS=8
MAX_CLAIMS_PER_SUBMISSION=3

# Local model inference. Needs requirements-ml.txt (~2 GB). Left off, the
# media detectors report "unavailable" and the report says so.
ENABLE_ML_DETECTORS=false

# ── Third-party keys ───────────────────────────────────────────
# Optional to *start*, but search quality depends on them almost entirely.
#
# With none set, retrieval runs on DuckDuckGo, RSS feeds and Wikipedia
# alone. The system still returns results and still looks like it is
# working -- the reports simply rest on a fraction of the intended
# evidence, which shows up as weak or off-topic sources and as verdicts
# that abstain when they should not. `GET /api/v1/health` reports
# `status: degraded` and names every provider that is missing, so this
# state is visible rather than something you infer from poor results.
#
# The two that matter most, in order:
#   GOOGLE_CSE_API_KEY + GOOGLE_CSE_ID  broadest general web index
#     https://programmablesearchengine.google.com/  (free tier: 100/day)
#   GOOGLE_FACTCHECK_API_KEY            published fact-checks with ratings
#     https://console.cloud.google.com/ -> enable "Fact Check Tools API"
#
# BRAVE_API_KEY or SERPAPI_API_KEY are good substitutes for the first.
# NEWSDATA/GNEWS add current news coverage for recent claims.
#
# GEMINI_API_KEY or ANTHROPIC_API_KEY enable the written explanation.
# Without one, reports show the engine's own reasoning instead — that is
# a supported configuration, not an error.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_FACTCHECK_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=
SERPAPI_API_KEY=
BRAVE_API_KEY=
NEWSDATA_API_KEY=
GNEWS_API_KEY=

# Verifying Supabase-issued tokens, if you use it for OAuth.
SUPABASE_JWT_SECRET=
