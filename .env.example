# ═══════════════════════════════════════════════
# TruthShield — Environment Configuration
# ═══════════════════════════════════════════════

# ── AI Model Keys (at least one required for verdict engine) ──
ANTHROPIC_API_KEY=your_anthropic_api_key
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key                    # Optional — only for Whisper audio

# ── Evidence Search APIs (more keys = better accuracy) ──
# ⭐ STRONGLY RECOMMENDED — Enables Google Search grounding + Fact Check
GOOGLE_FACTCHECK_API_KEY=your_google_factcheck_key    # Free — Google Cloud Console → Fact Check Tools API
GOOGLE_CSE_API_KEY=your_google_cse_api_key            # Free 100/day — Google Cloud Console → Custom Search JSON API
GOOGLE_CSE_ID=your_google_cse_id                      # Free — programmablesearchengine.google.com

# 🔍 ADDITIONAL SEARCH SOURCES (each improves accuracy)
SERPAPI_API_KEY=your_serpapi_key                       # Free 100/month — serpapi.com (real Google results)
BRAVE_API_KEY=                                        # Free 2000/month — brave.com/search/api

# 📰 NEWS APIs (for current events verification)
NEWSDATA_API_KEY=your_newsdata_io_key                 # Free 200/day — newsdata.io (80k+ sources)
GNEWS_API_KEY=your_gnews_api_key                      # Free 100/day — gnews.io
NEWSAPI_KEY=your_newsapi_key                          # Free 100/day — newsapi.org


# Social Ingestion Modules (7 platforms)
TWITTER_BEARER_TOKEN=your_twitter_bearer_token
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
TELEGRAM_API_ID=your_telegram_api_id
TELEGRAM_API_HASH=your_telegram_api_hash
YOUTUBE_API_KEY=your_youtube_data_api_v3_key
MASTODON_INSTANCE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=your_mastodon_access_token
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_GUILD_IDS=guild_id_1,guild_id_2

# Database
DATABASE_URL=postgresql://truthshield:truthshield_pass@db:5432/truthshield
REDIS_URL=redis://redis:6379/0

# JWT Auth
JWT_SECRET_KEY=change_this_to_a_random_64_char_hex_string
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# Twilio WhatsApp 
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token


# Model Paths
WHISPER_MODEL=base
XLM_ROBERTA_MODEL=xlm-roberta-base
EFFICIENTNET_MODEL=efficientnet-b4

# App Settings
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_URL=https://truthshield-five.vercel.app
CORS_ORIGINS=https://truthshield-five.vercel.app,http://localhost:5173
MAX_UPLOAD_SIZE_MB=100
RATE_LIMIT=60/minute

# Deployed Port (Render/Railway inject this dynamically as PORT)
# PORT=8000

# Supabase Auth Verification (for backend)
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_for_token_verification

# ───────────────────────────────────────────────────────────
# Frontend Environment Variables (Set on Vercel/Netlify)
# ───────────────────────────────────────────────────────────
# VITE_API_URL=https://truthshield-backendd.onrender.com/api/v1
# VITE_WS_URL=wss://truthshield-backendd.onrender.com/ws/analyze
# VITE_SUPABASE_URL=https://hjlcpxhlmjmyyhixnciu.supabase.co
# VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

